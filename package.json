{
    "name": "career-connect-lesotho-frontend",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "dev:local": "cross-env VITE_APP_ENVIRONMENT=local vite",
        "dev:prod": "cross-env VITE_APP_ENVIRONMENT=production vite",
        "build": "vite build",
        "build:dev": "cross-env VITE_APP_ENVIRONMENT=development vite build",
        "build:prod": "cross-env VITE_APP_ENVIRONMENT=production vite build",
        "preview": "vite preview",
        "preview:dev": "cross-env VITE_APP_ENVIRONMENT=development vite preview",
        "preview:prod": "cross-env VITE_APP_ENVIRONMENT=production vite preview",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext js,jsx --fix --max-warnings 0",
        "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
        "security": "npm audit",
        "deploy:dev": "npm run build:dev && firebase deploy --only hosting:development",
        "deploy:prod": "npm run build:prod && firebase deploy --only hosting:production",
        "analyze": "cross-env ANALYZE=true vite build",
        "type-check": "echo 'Using PropTypes for type checking'"
    },
