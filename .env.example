# ============================================
# FRONTEND - EXAMPLE CONFIGURATION (VITE)
# ============================================
# Copy this file to .env.local for local development
# Replace placeholder values with your actual configuration

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Admin Credentials (Change these!)
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=YourSecurePassword@123!!
VITE_SUPER_ADMIN_EMAIL=superadmin@example.com
VITE_SUPER_ADMIN_PASSWORD=YourSuperSecurePassword@123!!

# App Configuration
VITE_APP_NAME=Your App Name
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development
VITE_APP_BASE_URL=http://localhost:3000
VITE_APP_API_URL=http://localhost:5000/api
VITE_APP_WEBSOCKET_URL=ws://localhost:5000

# External APIs (Get your own keys)
VITE_NEWS_API_KEY=your-news-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
VITE_OPENAI_API_KEY=your-openai-key
VITE_SENDGRID_API_KEY=your-sendgrid-key
VITE_TWILIO_ACCOUNT_SID=your-twilio-sid
VITE_TWILIO_AUTH_TOKEN=your-twilio-token
VITE_PAYSTACK_PUBLIC_KEY=your-paystack-key
VITE_STRIPE_PUBLIC_KEY=your-stripe-key

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-cloudinary-api-key
VITE_CLOUDINARY_API_SECRET=your-cloudinary-api-secret
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
VITE_CLOUDINARY_FOLDER=your-folder-name

# Email Configuration
VITE_EMAIL_FROM=noreply@example.com
VITE_EMAIL_SUPPORT=support@example.com
VITE_EMAIL_ADMIN=admin@example.com
VITE_EMAIL_NOTIFICATIONS=notifications@example.com
VITE_SMTP_HOST=smtp.example.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your-smtp-user
VITE_SMTP_PASS=your-smtp-password

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000
VITE_API_VERSION=v1

# Environment Settings
VITE_DEBUG=false
VITE_LOG_LEVEL=error
VITE_ENABLE_HOT_RELOAD=true
VITE_ENABLE_REACT_STRICT_MODE=true
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_PWA=false
VITE_ENABLE_OFFLINE_MODE=false

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_REALTIME_UPDATES=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_MARKETPLACE=false
VITE_ENABLE_MENTORSHIP=true
VITE_ENABLE_INSTITUTE_PORTAL=true
VITE_ENABLE_COMPANY_PORTAL=true
VITE_ENABLE_YOUTH_PORTAL=true
VITE_ENABLE_ENTREPRENEUR_HUB=true

# UI/UX Settings
VITE_ENABLE_ANIMATIONS=true
VITE_DEFAULT_THEME=light
VITE_ITEMS_PER_PAGE=10
VITE_MAX_UPLOAD_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.pdf,.doc,.docx
VITE_DATE_FORMAT=YYYY-MM-DD
VITE_TIME_FORMAT=HH:mm:ss
VITE_DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss
VITE_CURRENCY=USD
VITE_TIMEZONE=Africa/Maseru

# Security Settings
VITE_ENABLE_STRICT_SECURITY=true
VITE_ENABLE_LOGGING=true
VITE_ENABLE_AUDIT_TRAIL=true
VITE_SESSION_TIMEOUT=3600000
VITE_REFRESH_TOKEN_INTERVAL=1800000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000
VITE_ENABLE_2FA=false
VITE_ENABLE_CAPTCHA=false
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Cache Settings
VITE_CACHE_DURATION=300000
VITE_CACHE_MAX_SIZE=50
VITE_ENABLE_PERSISTENT_CACHE=true
VITE_CACHE_VERSION=1

# Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=your-ga-id
VITE_SENTRY_DSN=your-sentry-dsn
VITE_MIXPANEL_TOKEN=your-mixpanel-token
VITE_HOTJAR_ID=your-hotjar-id

# Social Media
VITE_FACEBOOK_APP_ID=your-fb-app-id
VITE_LINKEDIN_CLIENT_ID=your-linkedin-id
VITE_TWITTER_CLIENT_ID=your-twitter-id
VITE_GITHUB_CLIENT_ID=your-github-id
VITE_GOOGLE_CLIENT_ID=your-google-id

# Rate Limiting
VITE_RATE_LIMIT_MAX_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

# Vite-specific settings
VITE_PUBLIC_PATH=/