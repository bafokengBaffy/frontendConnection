{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@context/*": [
        "src/context/*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@styles/*": [
        "src/styles/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@routing/*": [
        "src/routing/*"
      ],
      "@tests/*": [
        "__tests__/*"
      ],
      "@test-utils": [
        "__tests__/utils/test-utils.jsx"
      ]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "*.config.js",
    "*.config.mjs",
    "tailwind.config.cjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "public"
  ]
}
