{
    "name": "career-connect-lesotho-frontend",
    "version": "1.0.0",
    "scripts": {
      "start": "react-scripts start",
      "dev": "react-scripts start",
      "dev:local": "REACT_APP_ENVIRONMENT=local react-scripts start",
      "dev:prod": "REACT_APP_ENVIRONMENT=production react-scripts start",
      "build": "react-scripts build",
      "build:dev": "REACT_APP_ENVIRONMENT=development react-scripts build",
      "build:prod": "REACT_APP_ENVIRONMENT=production react-scripts build",
      "build:analyze": "ANALYZE=true react-scripts build",
      "test": "react-scripts test",
      "test:watch": "react-scripts test --watch",
      "test:coverage": "react-scripts test --coverage",
      "eject": "react-scripts eject",
      "lint": "eslint src/**/*.js",
      "lint:fix": "eslint src/**/*.js --fix",
      "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
      "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
      "type-check": "tsc --noEmit",
      "security": "npm audit",
      "generate:icons": "node scripts/generate-icons.js",
      "deploy:dev": "firebase deploy --only hosting:development",
      "deploy:prod": "firebase deploy --only hosting:production"
    },
    "dependencies": {
      "@csstools/normalize.css": "^12.1.1",
      "@react-aria/focus": "^3.21.3",
      "@react-aria/utils": "^5.9.0",
      "@tanstack/react-query": "^5.90.20",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.1",
      "aos": "^2.3.4",
      "axios": "^1.13.2",
      "bootstrap": "^5.3.8",
      "chart.js": "^4.5.1",
      "clsx": "^2.1.1",
      "compression": "^1.8.1",
      "date-fns": "^4.1.0",
      "date-fns-tz": "^3.2.0",
      "emoji-picker-react": "^4.17.1",
      "firebase": "^12.8.0",
      "formik": "^2.4.9",
      "framer-motion": "^12.29.0",
      "html2canvas": "^1.4.1",
      "jspdf": "^4.0.0",
      "jwt-decode": "^4.0.0",
      "lodash": "^4.17.23",
      "lottie-react": "^2.4.1",
      "prop-types": "^15.8.1",
      "react": "^19.2.3",
      "react-beautiful-dnd": "^13.1.1",
      "react-bootstrap": "^2.10.10",
      "react-bootstrap-icons": "^1.11.6",
      "react-chartjs-2": "^5.3.1",
      "react-countup": "^6.5.3",
      "react-datepicker": "^9.1.0",
      "react-device-detect": "^2.2.3",
      "react-dom": "^19.2.3",
      "react-dropzone": "^14.3.8",
      "react-error-boundary": "^6.1.0",
      "react-feather": "^2.0.10",
      "react-firebase-hooks": "^5.1.1",
      "react-hook-form": "^7.71.1",
      "react-hot-toast": "^2.6.0",
      "react-icons": "^5.5.0",
      "react-lazyload": "^3.2.1",
      "react-perfect-scrollbar": "^1.5.8",
      "react-quill": "^2.0.0",
      "react-responsive": "^10.0.1",
      "react-router-bootstrap": "^0.26.3",
      "react-router-dom": "^7.13.0",
      "react-scripts": "5.0.1",
      "react-select": "^5.10.2",
      "react-simple-chatbot": "^0.6.1",
      "react-swipeable": "^7.0.2",
      "react-textarea-autosize": "^8.5.9",
      "react-toastify": "^11.0.5",
      "react-tooltip": "^5.30.0",
      "react-virtualized": "^9.22.6",
      "recharts": "^3.7.0",
      "socket.io-client": "^4.8.3",
      "swiper": "^12.0.3",
      "web-vitals": "^5.1.0",
      "workbox-background-sync": "^7.4.0",
      "workbox-broadcast-update": "^7.4.0",
      "workbox-cacheable-response": "^7.4.0",
      "workbox-core": "^7.4.0",
      "workbox-expiration": "^7.4.0",
      "workbox-precaching": "^7.4.0",
      "workbox-routing": "^7.4.0",
      "workbox-strategies": "^7.4.0",
      "yup": "^1.7.1"
    },
    "devDependencies": {
      "@types/react": "^19.2.9",
      "@types/react-dom": "^19.2.3",
      "@typescript-eslint/eslint-plugin": "^8.53.1",
      "@typescript-eslint/parser": "^8.53.1",
      "autoprefixer": "^10.4.23",
      "babel-plugin-transform-imports": "^2.0.0",
      "compression-webpack-plugin": "^11.1.0",
      "copy-webpack-plugin": "^13.0.1",
      "css-minimizer-webpack-plugin": "^7.0.4",
      "cssnano": "^7.1.2",
      "customize-cra": "^1.0.0",
      "dotenv": "^17.2.3",
      "eslint": "^9.39.2",
      "eslint-config-react-app": "^7.0.1",
      "eslint-plugin-import": "^2.32.0",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^7.0.1",
      "eslint-plugin-react-perf": "^3.3.3",
      "mini-css-extract-plugin": "^2.10.0",
      "postcss": "^8.5.6",
      "postcss-preset-env": "^11.1.1",
      "prettier": "^3.8.1",
      "react-app-rewired": "^2.2.1",
      "source-map-explorer": "^2.5.3",
      "terser-webpack-plugin": "^5.3.16",
      "typescript": "^5.9.3",
      "webpack-bundle-analyzer": "^5.2.0"
    },
    "browserslist": {
      "production": [
        ">0.2%",
        "not dead",
        "not op_mini all",
        "not ie > 0",
        "not samsung 4",
        "not and_uc 12.12"
      ],
      "development": [
        "last 1 chrome version",
        "last 1 firefox version",
        "last 1 safari version"
      ]
    }
  }