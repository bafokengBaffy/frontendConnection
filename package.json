{
  "name": "career-connect-lesotho-frontend",
  "version": "2.0.0",
  "description": "Career Connect Lesotho - Frontend Application for connecting job seekers with employers in Lesotho",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Career Connect Lesotho Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/career-connect-lesotho-frontend.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit --skipLibCheck",
    "type-check:watch": "tsc --noEmit --skipLibCheck --watch",
    "clean": "rimraf dist node_modules/.vite .eslintcache",
    "clean:all": "rimraf dist node_modules .eslintcache package-lock.json",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "commit": "git-cz",
    "release": "standard-version",
    "analyze": "rollup-plugin-visualizer",
    "plop": "plop",
    "fix-all": "npm run clean && npm install && npm run lint:fix && npm run format && npm run type-check"
  },
